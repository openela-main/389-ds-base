+                }
+                /* copy config so it doesn't change out from under us */
+                memberof_copy_config(&configCopy, mainConfig);
+                config_copied = 1;
+            }
+            memberof_unlock_config();
+        } else if (memberof_is_grouping_attr(type, &configCopy)) {
+            interested = 1;
+        }
