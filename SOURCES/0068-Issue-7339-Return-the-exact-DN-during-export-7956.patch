 .../slapd/back-ldbm/db-bdb/bdb_ldif2db.c      | 10 ++++
 .../slapd/back-ldbm/db-mdb/mdb_ldif2db.c      | 17 +++++--
 3 files changed, 72 insertions(+), 3 deletions(-)

