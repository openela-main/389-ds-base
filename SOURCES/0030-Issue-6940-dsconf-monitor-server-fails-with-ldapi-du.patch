         else:
             self.ds_paths = Paths(instance=self, local=self.isLocal)
 
@@ -1032,6 +1100,17 @@ class DirSrv(SimpleLDAPObject, object):
             self.__initPart2()
         self.state = DIRSRV_STATE_ONLINE
