     }
+    if (operator & SLAPI_OP_RANGE_NO_IDL_SORT) {
+        return idl_new_parentid_sorted_range_fetch(be, db, lowerkey, upperkey, txn, ai,
+                                                 flag_err, allidslimit, sizelimit,
