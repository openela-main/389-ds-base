+            ctx->count++;
         }
-        ctx->count++;
 
 #if defined(DB_ALLIDS_ON_READ)
         if ((NEW_IDL_NO_ALLID != *(ctx->flag_err)) && ctx->ai && (ctx->idl != NULL) &&
@@ -506,6 +511,10 @@ idl_parentid_walk_tree(idl_parentid_walk_ctx_t *ctx, ID root_id, ID **stack,
         }
 #endif
